{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__claude-skills-cli__run_command",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/cli-loop-guard?agent=claude&cwd=${CLAUDE_PROJECT_DIR}\" || true",
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__filesystem__list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/dir-cache-guard?agent=claude&cwd=${CLAUDE_PROJECT_DIR}\" || true",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/prompt-context?agent=claude&cwd=${CLAUDE_PROJECT_DIR}\" || true",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/budget?agent=claude&cwd=${CLAUDE_PROJECT_DIR}\" || true",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/task-drift?agent=claude&cwd=${CLAUDE_PROJECT_DIR}\" || true",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/session-stop?agent=claude&cwd=${CLAUDE_PROJECT_DIR}\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" --data @- \"http://127.0.0.1:4895/hook/official-skills?agent=claude&cwd=${CLAUDE_PROJECT_DIR}\" || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
